# Application
APP_NAME="StudyVerse API"
VERSION="1.0.0"
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://studyverse:studyverse_pass@db:5432/studyverse

# Redis
REDIS_URL=redis://redis:6379

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Firebase (optional)
FIREBASE_CREDENTIALS=

# AWS S3 (optional)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
S3_BUCKET=studyverse-uploads

# AI Settings
AI_CONFIDENCE_THRESHOLD=0.85
MIN_STUDY_DURATION_SECONDS=300
